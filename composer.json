{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "ext-soap": "*",
        "barryvdh/laravel-ide-helper": "^3.1",
        "laravel/framework": "^12.0",
        "laravel/sanctum": "^4.0",
        "laravel/telescope": "^5.18",
        "laravel/tinker": "^2.9",
        "spatie/laravel-collection-macros": "^8.0",
        "spatie/laravel-data": "*"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.26",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.0.1",
        "roave/security-advisories": "dev-latest",
        "spatie/laravel-web-tinker": "^1.9",
        "symplify/easy-coding-standard": "^12.2"
    },
    "autoload": {
        "files": [
            "app/V1/Core/Domain/Helpers/helpers.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint:phpstan": "vendor/bin/phpstan analyse -c phpstan.neon",
        "lint:pint": "vendor/bin/pint --test",
        "fmt": "vendor/bin/pint",
        "test": "php artisan test",
        "ci": [
            "@lint:phpstan",
            "@lint:pint",
            "@test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "ecs-fix": [
            "vendor/bin/ecs check app --fix"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "laravel/telescope"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
