includes:
  - vendor/larastan/larastan/extension.neon

parameters:
  level: 4
  paths:
    - app/V1
    - tests
    - database

  tmpDir: storage/framework/phpstan

  excludePaths:
    - vendor
    - storage
    - bootstrap/cache
    - app/V1/Shared/Domain/Traits/HasChildrenTrait.php
    - app/V1/Shared/Domain/Traits/HasOrderTrait.php
